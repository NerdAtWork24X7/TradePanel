# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
.eggs/
pip-wheel-metadata/

# PyInstaller work dir; backend/build/ itself holds the tracked backend.spec
backend/build/work/

# ── Virtual environments ─────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Secrets & credentials (never commit) ─────────────────────────────────────
.env
.env.*
!.env.example
keys/
*.pem
*.key
*.p12
*.pfx

# ── Runtime data (generated at runtime) ─────────────────────────────────────
data/
*.db
*.sqlite
*.sqlite3

# ── Tooling / caches ────────────────────────────────────────────────────────
.ruff_cache/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/
.tox/
.nox/

# ── Agent / local tooling state ──────────────────────────────────────────────
.pi/
.pi-scope/
.pi_memory/

# ── OS / editor ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo
*~

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log

# ── Temp generated artifacts (scripts themselves are kept) ───────────────────
tmp/



# ── Tauri / frontend build artifacts ─────────────────────────────────────────
node_modules/
frontend/dist/
src-tauri/target/
src-tauri/gen/
src-tauri/backend-dist/
src-tauri/ai-runtime/*
!src-tauri/ai-runtime/README.md
backend/build/dist/
backend/build/work/
backend/build/ai-staging/
backend/build/ai-cache/
.venv-build/
backend/build/