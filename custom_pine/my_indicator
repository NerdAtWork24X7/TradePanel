lowerBand_1 = plot(lowerBandValue1, title = 'Lower Band #1', color = color.gray, offset = offset, display = showBand_1 and Show_VWap ? display.all : display.none)
//fill(upperBand_1, lowerBand_1, title="Bands Fill #1", color= color.new(color.green, 95)    , display = showBand_1 and Show_VWap_band ? display.all : display.none)

upperBand_2 = plot(upperBandValue2, title = 'Upper Band #2', color = color.red, offset = offset, display = showBand_2 and Show_VWap ? display.all : display.none)
upperBand_3 = plot(upperBandValue3, title = 'Upper Band #3', color = color.red, offset = offset, display = showBand_3 and Show_VWap ? display.all : display.none)
fill(upperBand_2, upperBand_3, title = 'Bands Fill #2', color = color.new(color.red, 95), display = showBand_2 and Show_VWap_band ? display.all : display.none)



lowerBand_2 = plot(lowerBandValue2, title = 'Lower Band #2', color = color.green, offset = offset, display = showBand_2 and Show_VWap ? display.all : display.none)
lowerBand_3 = plot(lowerBandValue3, title = 'Lower Band #3', color = color.green, offset = offset, display = showBand_3 and Show_VWap ? display.all : display.none)
fill(lowerBand_2, lowerBand_3, title = 'Bands Fill #3', color = color.new(color.green, 95), display = showBand_3 and Show_VWap_band ? display.all : display.none)




// ---------- Session detection (first-15min window of each session, UTC) ----------
inAsia   = not na(time("", asiaSess,   "UTC"))
inLondon = not na(time("", londonSess, "UTC"))
inNYAM   = not na(time("", nyamSess,   "UTC"))
inNYPM   = not na(time("", nypmSess,   "UTC"))
sessionIdx = inAsia ? 0 : inLondon ? 1 : inNYAM ? 2 : inNYPM ? 3 : -1

// ---------- Session high / low (per-session, first-15min window) ----------
var float sHigh = na
var float sLow  = na
var int   lastSession = -1
prevSHigh = sHigh
prevSLow  = sLow
sessStart = sessionIdx >= 0 and (sessionIdx != lastSession or na(sHigh))
if sessionIdx >= 0
    if sessionIdx != lastSession or na(sHigh)
        sHigh := high
        sLow  := low
        lastSession := sessionIdx
    else
        sHigh := math.max(sHigh, high)
        sLow  := math.min(sLow, low)

// ---------- Session boxes + labels ----------
var array<color>  sessionColors = array.from(color.blue, color.purple, color.teal, color.orange)
var array<string> sessionNames  = array.from("Asia", "London", "NY AM", "NY PM")
var box[]   sessBoxes   = array.new_box()
var label[] sessLabels  = array.new_label()
var box     activeBox   = na
var label   activeLabel = na
var int     prevIdx     = -1

if showSession
    if sessionIdx >= 0 and sessionIdx != prevIdx
        // new session: start a fresh box + name label, extending until the next session begins
        col = array.get(sessionColors, sessionIdx)
        nm  = array.get(sessionNames, sessionIdx)
        activeBox   := box.new(bar_index, sHigh, bar_index, sLow, bgcolor=color.new(col, 90),border_color =color.new(col, 90))
        activeLabel := label.new(bar_index, sHigh, nm, style=label.style_label_down, color=col, textcolor=color.white, size=size.small)
        array.push(sessBoxes, activeBox)
        array.push(sessLabels, activeLabel)
        if array.size(sessBoxes) > 250
            box.delete(array.shift(sessBoxes))
            label.delete(array.shift(sessLabels))
    else if not na(activeBox)
        // keep stretching the active session's high/low band until the next session starts
        box.set_right(activeBox, bar_index)
        box.set_top(activeBox, sHigh)
        box.set_bottom(activeBox, sLow)
        label.set_y(activeLabel, sHigh)
prevIdx := sessionIdx

// ---------- Volume Profile (previous-day, tick rows + Value Area, offset to current day) ----------
showVP     = input.bool(true,  "Show Volume Profile", group="Volume Profile")
vpRowTicks = input.int(1,   "Row Size (Ticks)", minval=1, maxval=50, group="Volume Profile")
vpValPct   = input.int(70,  "Value Area Volume %", minval=50, maxval=100, group="Volume Profile")

// Calendar-day boundary
var int   curDayStart = na   // bar index of the current day's first bar
bool newDay = not barstate.isfirst and ta.change(time("D")) != 0

// Stored previous-day profile (finalized once at each new-day open)
var float   vpVahPx = na
var float   vpValPx = na
var float   vpPocPx = na
var bool    vpReady = false
var int     lastLineBar = na  // bar index where lines were last created (real-time dedup)

// Active (current day) lines — re-created each new day, never deleted -> one set per day
var line vpVahLine = na
var line vpValLine = na
var line vpPocLine = na

// --- New day: finalize the previous day's profile, then draw it on the new day ---
if barstate.isfirst
    curDayStart := bar_index
else if newDay and (na(lastLineBar) or bar_index != lastLineBar)
    int finishedStart = curDayStart
    curDayStart := bar_index
    int nb = bar_index - finishedStart
    if nb >= 1 and showVP
        float vh = high[nb], vl = low[nb]
        for i = nb - 1 to 1
            vh := math.max(vh, high[i])
            vl := math.min(vl, low[i])
        float rng = vh - vl
        float tick = syminfo.mintick
        float rowSz = tick * vpRowTicks
        if rng > 0 and rowSz > 0
            int rows = int(math.max(1, math.ceil(rng / rowSz)))
            float[] vols = array.new_float(rows, 0.0)
            for i = nb to 1
                float hh = high[i], ll = low[i], vv = volume[i]
                float cR = hh - ll
                if cR <= 0
                    continue
                for j = 0 to rows - 1
                    float rl = vl + j * rowSz
                    float rh = math.min(rl + rowSz, vh)
                    if hh >= rl and ll <= rh
                        float ov = math.min(hh, rh) - math.max(ll, rl)
                        if ov > 0
                            array.set(vols, j, array.get(vols, j) + vv * (ov / cR))
            float total = 0.0
            for j = 0 to rows - 1
                float vvj = array.get(vols, j)
                total += vvj
            int pocIdx = 0
            for j = 1 to rows - 1
                if array.get(vols, j) > array.get(vols, pocIdx)
                    pocIdx := j
            float target = total * vpValPct / 100.0
            float cum = array.get(vols, pocIdx)
            int vaL = pocIdx, vaH = pocIdx
            bool[] usedArr = array.new_bool(rows, false)
            array.set(usedArr, pocIdx, true)
            int safety = rows
            while cum < target and safety > 0
                safety -= 1
                int nL = vaL - 1, nH = vaH + 1
                bool okL = nL >= 0 and not array.get(usedArr, nL)
                bool okH = nH < rows and not array.get(usedArr, nH)
                if not okL and not okH
                    break
                if okL and (not okH or array.get(vols, nL) >= array.get(vols, nH))
                    array.set(usedArr, nL, true)
                    if array.get(vols, nL) > 0
                        cum += array.get(vols, nL)
                        vaL := nL
                else
                    array.set(usedArr, nH, true)
                    if array.get(vols, nH) > 0
                        cum += array.get(vols, nH)
                        vaH := nH
            vpVahPx := vl + (vaH + 1) * rowSz
            vpValPx := vl + vaL * rowSz
            vpPocPx := vl + (pocIdx + 0.5) * rowSz
            vpReady := true
            color vpC = color.new(color.gray, 30)
            vpVahLine := line.new(bar_index, vpVahPx, bar_index, vpVahPx, color=vpC, width=2, style=line.style_dotted)
            vpValLine := line.new(bar_index, vpValPx, bar_index, vpValPx, color=vpC, width=2, style=line.style_dotted)
            vpPocLine := line.new(bar_index, vpPocPx, bar_index, vpPocPx, color=color.new(color.red, 15), width=2, style=line.style_dotted)
            lastLineBar := bar_index

// --- Each bar: extend the active day's lines to the current bar (reaches end of day) ---
if vpReady and showVP
    if not na(vpVahLine)
        line.set_xy2(vpVahLine, bar_index, vpVahPx)
        line.set_xy2(vpValLine, bar_index, vpValPx)
        line.set_xy2(vpPocLine, bar_index, vpPocPx)



//#region ———————————————————— Inputs
// @variable Toggle to show volume bubbles
bool  bubles     = input.bool(true, "", group = "Bubles", inline = "1")
// @variable Threshold for volume significance
float threshold  = input.float(1, "Threshold", step = 0.1, maxval = 7, group = "Bubles", inline = "1")
// @variable Toggle for heatmap coloring
bool  color_     = input.bool(false, "HeatMap", group = "Bubles")

// @variable Toggle to show significant volume levels
bool  levels     = input.bool(false, "Significant Levels", "Significant Volume Levels", group = "Volume Levels")
// @variable Qty of significant volume levels
int   levels_qty = input.int(10, "Levels Qty", group = "Volume Levels")

// @variable Main color for volume bubbles
color m_col = color.green
 
// @variable Color definitions for heatmap
color col1  = color.new(color.aqua, 50)
color col2  = color.new(color.green, 50)
color col3  = color.new(color.yellow, 50)
color col4  = color.new(color.orange, 30)
color col5  = #d32626
//#endregion

//#region ———————————————————— Calculations
series float VOL      = volume
series float source   = hl2
// @variable Normalized volume
series float norm_vol = VOL / ta.stdev(VOL, 200)

// @variable Color gradient based on normalized volume
color gradient_col    = not color_
                         ? color.from_gradient(
                             norm_vol, 0, 8, 
                             chart.bg_color == color.white ? color.new(m_col, 100) : color.rgb(18, 34, 18, 50),
                             m_col
                             )
                         :
                          (
                          norm_vol < 1
                          ? color.from_gradient(norm_vol, 0, 1, col1, col2) 
                          : norm_vol > 1 and norm_vol < 4
                          ? color.from_gradient(norm_vol, 1, 4, col3, col4)
                          : norm_vol > 4 
                          ? color.from_gradient(norm_vol, 4, 8, col4, col5) : na
                          )

// @variable Conditions for different volume levels
bool condition1 = norm_vol > 0 and norm_vol < threshold and bubles
bool condition2 = norm_vol > threshold and norm_vol < 3  and bubles
bool condition3 = norm_vol > threshold+2 and norm_vol < 4 and bubles
bool condition4 = norm_vol > threshold+3 and norm_vol < 6 and bubles
bool condition5 = norm_vol > 6
//#endregion

//#region ———————————————————— Plotting
// Plot labels for significant volume levels
if condition5 and (levels or bubles)
    label.new(bubles ? bar_index : last_bar_index, source, str.tostring(volume, format.volume), xloc.bar_index, yloc.price ,
                 #00000000, bubles ? label.style_label_center : label.style_label_left, chart.fg_color)

// Plot lines for significant volume levels
if condition5 and levels
    line.new(bar_index, source, last_bar_index, source, xloc.bar_index, extend.none, gradient_col, width = 2) 

// Plot volume bubbles of different sizes based on volume levels
plotshape(condition1 ? source : na, "", shape.circle, location.absolute, gradient_col, 0, "", na, size = size.tiny)
plotshape(condition2 ? source : na, "", shape.circle, location.absolute, gradient_col, 0, "", na, size = size.small)
plotshape(condition3 ? source : na, "", shape.circle, location.absolute, gradient_col, 0, "", na, size = size.normal)
plotshape(condition4 ? source : na, "", shape.circle, location.absolute, gradient_col, 0, "", na, size = size.large)
plotshape(condition5 and bubles ? source : na, "", shape.circle, location.absolute, gradient_col, 0, "", na, size = size.huge)

// Manage the number of lines and labels on the chart
a_allLines = line.all
if array.size(a_allLines) > levels_qty
    line.delete(array.shift(a_allLines))

a_allLabels = label.all
if array.size(a_allLabels) > levels_qty and not bubles
    label.delete(array.shift(a_allLabels))
    
// Warning if no Volume data Provided
if ta.cum(volume) <= 0 and barstate.islast
    label.new(bar_index, hl2, "No Volume Data Provided\n Use other Symbol", 
                 style     = label.style_label_left, 
                 textcolor = chart.fg_color)
//#endregion

