{
  "name": "tradepanel-desktop",
  "private": true,
  "version": "0.4.24",
  "description": "TradePanel on OpenTrader (Tauri 2 + SolidJS)",
  "scripts": {
    "start": "node scripts/tradepanel.mjs",
    "dev": "npm --prefix opentrader run tauri dev",
    "build": "npm --prefix opentrader run tauri build",
    "tauri": "npm --prefix opentrader run tauri",
    "ot:install": "npm --prefix opentrader ci",
    "ot:test": "npm --prefix opentrader test",
    "ot:crypto": "node opentrader/scripts/install-crypto-plugin.mjs",
    "ot:frontend:build": "npm --prefix opentrader run build"
  }
}
