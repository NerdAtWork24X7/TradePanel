+/// The command that runs a plugin program. A Python entry (`plugin.py`) runs under the
+/// plugin's own virtualenv when it ships one, else the system Python: the package needs no
+/// executable bit and no per-platform launcher, and its dependencies stay inside its folder.
+fn plugin_command(dir: &Path, entry: &str, exe: &Path) -> tokio::process::Command {
+    if !entry.to_ascii_lowercase().ends_with(".py") {
+        return tokio::process::Command::new(exe);
+    }
+    let venv = if cfg!(windows) { dir.join(".venv").join("Scripts").join("python.exe") } else { dir.join(".venv").join("bin").join("python") };
+    let python = if venv.is_file() {
+        venv
+    } else if cfg!(windows) {
+        PathBuf::from("python")
+    } else {
+        PathBuf::from("python3")
+    };
+    let mut cmd = tokio::process::Command::new(python);
+    cmd.arg(exe);
+    cmd
+}
