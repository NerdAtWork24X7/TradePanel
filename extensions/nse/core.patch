+
+/// Ask each connected data plugin to rebuild its symbol universe. A plugin without a
+/// refresh handler answers "method not found"; one slow or broken plugin cannot hold up the others.
+pub async fn refresh_symbols(app: &AppHandle) {
+    let plugins: BTreeSet<String> = {
+        let s = state(app);
+        s.exchanges.locked().values().cloned().collect()
+    };
+    let hub = app.state::<Plugins>().hub.clone();
+    let asks = plugins.into_iter().filter(|p| hub.connected(p).is_some()).map(|plugin| {
+        let hub = hub.clone();
+        async move {
+            if let Err(error) = hub.request(&plugin, "data.refreshSymbols", json!({}), Duration::from_secs(30)).await {
+                eprintln!("plugins: {plugin} could not refresh symbols: {error}");
+            }
+        }
+    });
+    futures_util::future::join_all(asks).await;
 }
 
 /// A plugin's search answer as rows: the symbols of its exchanges (of `only`, when the query names one), 50 at most.
