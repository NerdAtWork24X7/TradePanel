+/**
+ * Whether a tab's symbols can only come from the provider (a data plugin): the
+ * static catalogue has none of them (crypto, forex, futures, indices, bonds), so
+ * the tab asks the live search even before a character is typed.
+ */
+export function liveOnlyCategory(category: SymbolCategoryId): boolean {
+  return category !== 'all' && category !== 'local' && !SYMBOLS.some((s) => s.category === category);
+}
+
+/**
+ * Whether the symbol search asks the provider for `query` on `category`: always on a tab only the
+ * provider can fill, else once a character is typed. Shared by the request and the rows so the
+ * dialog never shows rows it did not ask for.
+ */
+export function searchesLive(query: string, category: SymbolCategoryId): boolean {
+  return query.trim().length > 0 || liveOnlyCategory(category);
+}
