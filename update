#!/bin/sh
# Update TradePanel's generated OpenTrader checkout and reapply the extension packs.
# The work is done by tradepanel.mjs (this is `tradepanel.mjs --update --setup`).
#
#   ./update                re-assemble at the ref in opentrader.config.json
#   ./update --ref main     another tag, branch or commit
#   ./update --latest       the newest vX.Y.Z release tag
#
# Everything is passed to tradepanel.mjs; run `./tradepanel.mjs --help` for all flags.
set -eu
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
# A desktop launcher runs this without the login shell, so a version manager's node and npm are off
# PATH. nvm keeps every install in one tree; take the newest and carry on.
if ! command -v node >/dev/null 2>&1; then
  for dir in "${NVM_DIR:-${HOME:-}/.nvm}"/versions/node/*/bin; do
    if [ -x "$dir/node" ]; then PATH="$dir:$PATH"; fi
  done
fi
if ! command -v node >/dev/null 2>&1; then
  echo "update: Node.js 22 or newer is required (https://nodejs.org)." >&2
  exit 1
fi
exec node "$here/tradepanel.mjs" --update --setup "$@"
