+ *  the same ticker listed on several venues is distinguishable at a glance. */
+export function symbolExchangePrefix(symbolName: string, ticker: string): string | null {
+  if (!symbolName || !ticker || !symbolName.endsWith(ticker)) return null;
+  const prefix = symbolName.slice(0, symbolName.length - ticker.length);
+  return prefix.length > 1 && prefix.endsWith(":") ? prefix : null;
+}
