+/// The system credential store: one entry per plugin and setting key.
+fn secret_name(id: &str, key: &str) -> String {
+    format!("plugin:{id}:{key}")
+}
+
+fn read_secret(app: &AppHandle, id: &str, key: &str) -> Option<String> {
+    credentials::read(&app.config().identifier, &secret_name(id, key)).ok().flatten()
+}
+
+fn store_secret(app: &AppHandle, id: &str, key: &str, value: &str) -> Result<(), String> {
+    let service = &app.config().identifier;
+    let name = secret_name(id, key);
+    let stored = if value.is_empty() {
+        credentials::delete(service, &name)
+    } else {
+        credentials::write(service, &name, value)
+    };
+    stored.map_err(|e| format!("credential store: {e}"))
+}
