+/// Remove one stored secret (`Settings > Plugins`, the Clear button beside a secret field).
+#[tauri::command]
+#[specta::specta]
+pub fn plugin_clear_secret(app: AppHandle, id: String, key: String) -> Result<PluginsStatus, String> {
+    let m = installed_manifest(&app, &id).ok_or_else(|| format!("{id} is not installed"))?;
+    if !m.settings.iter().any(|f| f.key == key && f.kind == SettingKind::Secret) {
+        return Err(format!("{key} is not a secret setting of {id}"));
+    }
+    store_secret(&app, &id, &key, "")?;
+    update_plugin(&app, &id, |p| p.secret_keys.retain(|k| k != &key))?;
+    configure(&app, &id);
+    Ok(status(&app))
