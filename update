#!/bin/sh
# Update TradePanel's generated OpenTrader checkout and reapply the extension packs.
#
#   ./update                       ref pinned in opentrader.config.json (v0.4.25)
#   ./update --ref main            upstream HEAD
#   ./update --check               assemble, typecheck and run the tests
#   ./update --without analyst     assemble without one pack
#   ./update --locked              reproduce opentrader.lock.json
#
# Everything is passed to scripts/update-opentrader.mjs; run `./update --help` for all flags.
set -eu
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if ! command -v node >/dev/null 2>&1; then
  echo "update: Node.js 22 or newer is required (https://nodejs.org)." >&2
  exit 1
fi
exec node "$here/scripts/update-opentrader.mjs" "$@"
