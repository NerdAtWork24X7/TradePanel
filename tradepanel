#!/bin/sh
# TradePanel: set the workspace up and run the app. The work is done by tradepanel.mjs.
#
#   ./tradepanel                set up if needed, then start the desktop app
#   ./tradepanel --setup        set up only, do not start
#   ./tradepanel -- --no-watch  arguments after -- go to "tauri dev"
#
# Everything is passed to tradepanel.mjs; run `./tradepanel.mjs --help` for all flags.
set -eu
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if ! command -v node >/dev/null 2>&1; then
  echo "tradepanel: Node.js 22 or newer is required (https://nodejs.org)." >&2
  exit 1
fi
exec node "$here/tradepanel.mjs" "$@"
